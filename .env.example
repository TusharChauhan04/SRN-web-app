# ─────────────────────────────────────────────────────────────────────────────
# SRN Web — environment variables
#
# Copy to `.env.local` (or `.env`) and fill in. Never commit a filled-in copy;
# `.gitignore` excludes every `.env*` except this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (PLACEHOLDER) ───────────────────────────────────────────────────
# The real database has not been chosen yet. This currently points at a local
# SQLite file. See DATABASE.md for exactly what to change when the real one is
# picked — SQLite does NOT work on serverless hosting with a writable file.
#   SQLite   : file:./dev.db
#   Postgres : postgresql://USER:PASSWORD@HOST:5432/srn?schema=public
#   MySQL    : mysql://USER:PASSWORD@HOST:3306/srn
DATABASE_URL="file:./dev.db"

# ── Firebase Auth (client-side, public) ──────────────────────────────────────
# From Firebase Console → Project settings → Your apps → Web app → SDK setup.
# These are public identifiers by design, not secrets — they ship in the bundle.
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyExample-Replace-Me"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:abcdef1234567890"

# ── Firebase Admin (server-side, SECRET) ─────────────────────────────────────
# Service-account credentials used by Route Handlers to verify ID tokens and
# mint session cookies. Firebase Console → Project settings → Service accounts
# → Generate new private key.
# FIREBASE_PRIVATE_KEY keeps literal \n escapes; the code unescapes them.
FIREBASE_PROJECT_ID="your-project"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# ── Razorpay (payments) ──────────────────────────────────────────────────────
# Use TEST keys (rzp_test_*) for development. The key id is sent to the browser
# to open Checkout; the secret and webhook secret are server-only.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_ReplaceMe"
RAZORPAY_KEY_SECRET="ReplaceMe"
RAZORPAY_WEBHOOK_SECRET="ReplaceMe"

# ── File storage ─────────────────────────────────────────────────────────────
# Which StorageProvider implementation to use. "local" writes to ./public/uploads
# and is a development placeholder only — see src/lib/storage/.
#   local    : no extra config needed
#   firebase : requires the Firebase Admin vars above + a bucket name
STORAGE_PROVIDER="local"
FIREBASE_STORAGE_BUCKET="your-project.appspot.com"

# ── App ──────────────────────────────────────────────────────────────────────
# Public origin, used for absolute URLs (webhooks, share links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"