# ─────────────────────────────────────────────────────────────────────────────
# SRN Web — environment variables
#
# Copy to `.env.local` and fill in. Never commit a filled-in copy; `.gitignore`
# excludes every `.env*` except this file.
#
# THE APP RUNS WITH NO CHANGES TO THIS FILE. Auth and payments both default to
# working local implementations, so you can develop the whole product before any
# third-party account exists. Connecting the real services is a provider switch
# plus credentials — no code changes. See README.md "Connecting real services".
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# BOTH are required. The schema declares both, and `prisma migrate` fails with
# P1012 ("Environment variable not found: DIRECT_URL") if the second is missing
# — including on a fresh clone, before you have written a line of code.
#
# They differ by PORT, and the difference matters:
#
#   DATABASE_URL  :6543  transaction pooler — every request the app serves
#   DIRECT_URL    :5432  session pooler     — migrations only, never requests
#
# ?pgbouncer=true is NOT optional on the pooled URL. Transaction-mode PgBouncer
# cannot hold prepared statements across a connection; without the flag Prisma
# emits them anyway and fails intermittently under concurrency — which no
# single-user test will ever reproduce.
#
# &connection_limit=1 matters on Vercel: each serverless invocation is its own
# process, so a default pool per invocation multiplies out and exhausts the
# pooler. Chat polls every 5s per open tab, which is the load shape that finds
# this first.
#
# Supabase → Project Settings → Database → Connection string.
# There is no local/file option any more: every environment is a real Postgres.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Used only by `pnpm test`. Point at the DIRECT (:5432) URL with a DEDICATED
# schema.
#
# Setup itself is additive — CREATE SCHEMA IF NOT EXISTS, then `migrate deploy`
# — so it cannot drop anything. The danger is in the SUITE: it deletes every row
# in every table before each test. Point it at `public` and it empties the
# application's data one test at a time, with no error.
#
# tests/global-setup.ts therefore refuses a URL with no ?schema= (Postgres would
# default to `public`), refuses ?schema=public, and refuses a URL that specifies
# ?schema= more than once.
#
# Do NOT add connection_limit=1 here: it would serialise the concurrency test
# that verifies rate limiting is atomic, making it pass for an implementation
# that is not.
TEST_DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=srn_test"

# ── App ──────────────────────────────────────────────────────────────────────
# Public origin. Used for absolute URLs and to reject cross-origin API calls,
# so it MUST be set correctly in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Reverse proxies in front of the app. X-Forwarded-For is appended to by each
# hop, so this decides how many rightmost entries are trusted. 1 is correct for
# Vercel. Set it correctly or rate limiting can be bypassed with a header.
TRUSTED_PROXY_COUNT="1"


# ═════════════════════════════════════════════════════════════════════════════
# AUTHENTICATION
# ═════════════════════════════════════════════════════════════════════════════
# "mock"     — development default. Any email signs in, no password checked.
#              Refuses to run when NODE_ENV=production.
# "firebase" — production. Requires the credentials below.
#
# Defaults to mock in development, firebase in production, so a missing
# variable fails loudly rather than silently authenticating everyone.
AUTH_PROVIDER="mock"
# Must match AUTH_PROVIDER — the browser needs to know which client to use.
NEXT_PUBLIC_AUTH_PROVIDER="mock"

# Optional: pins the mock signing key so sessions survive a dev-server restart.
# MOCK_AUTH_SECRET="any-string-at-least-16-chars"

# ── Firebase Auth: client (public by design, ships in the bundle) ────────────
# Firebase Console → Project settings → Your apps → Web app → SDK setup.
# Only needed when AUTH_PROVIDER=firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ── Firebase Auth: server (SECRET) ──────────────────────────────────────────
# Project settings → Service accounts → Generate new private key.
# Keep the literal \n escapes exactly as downloaded; the code unescapes them.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""


# ═════════════════════════════════════════════════════════════════════════════
# PAYMENTS
# ═════════════════════════════════════════════════════════════════════════════
# "mock"     — development default. The full order → checkout → webhook → grant
#              flow works, with real signature verification, but takes no money.
#              Refuses to run when NODE_ENV=production.
# "razorpay" — production. Requires the keys below.
PAYMENT_PROVIDER="mock"

# Optional: pins the mock webhook signing key across restarts.
# MOCK_PAYMENT_SECRET="any-string"

# ── Razorpay ────────────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys. Use rzp_test_* keys until you go live.
# The key id is sent to the browser to open Checkout — that one is not a secret.
# The webhook secret is set when you register the webhook endpoint at
# <NEXT_PUBLIC_APP_URL>/api/v1/payments/webhook
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""


# ═════════════════════════════════════════════════════════════════════════════
# EMAIL
# ═════════════════════════════════════════════════════════════════════════════
# The settings screen offers an "email me these" toggle. Without a provider it
# would silently do nothing, which is worse than not offering it.
#
# "console" — development default. Logs the message instead of sending.
# "smtp"    — production. Requires the keys below (not implemented yet; the
#             interface is final, see src/lib/providers/email/).
EMAIL_PROVIDER="console"
EMAIL_API_KEY=""
EMAIL_FROM=""


# ═════════════════════════════════════════════════════════════════════════════
# ONE-TIME CODES (phone verification)
# ═════════════════════════════════════════════════════════════════════════════
# "console" — development default. Logs the code and shows it in the UI.
#             Refuses to run when NODE_ENV=production.
# "sms"     — production. Not implemented yet; the interface is final, see
#             src/lib/providers/otp/.
OTP_PROVIDER="console"
SMS_API_KEY=""
SMS_SENDER_ID=""

# Optional: pins the mock OTP signing key across dev-server restarts.
# MOCK_AUTH_SECRET is separate and covers auth.


# ═════════════════════════════════════════════════════════════════════════════
# FILE STORAGE
# ═════════════════════════════════════════════════════════════════════════════
# "local" writes to ./.data/uploads — development only, and NOT viable on
# serverless hosting for the same reason SQLite isn't.
# Note the path: NOT public/. Anything under public/ is served unauthenticated
# by Next.js at the root path, which would make every KYC document readable by
# URL. Do not move it back.
#
# "local" | "supabase" | "firebase". In production an unrecognised value
# resolves to a PRODUCTION provider and fails loudly, rather than quietly
# falling back to local disk — a typo must never end with identity documents on
# an ephemeral filesystem.
#
# "supabase" is the intended production value. "firebase" remains selectable but
# is still an unimplemented stub that throws on every method.
#
# KYC documents are identity documents: whatever backs this must serve them via
# short-lived signed URLs, never a public bucket. The Supabase provider does
# this for the `document` and `evidence` contexts regardless of whether the
# bucket itself is public.
STORAGE_PROVIDER="local"

# ── Supabase Storage (when STORAGE_PROVIDER=supabase) ───────────────────────
# Supabase → Project Settings → API.
#
# SUPABASE_SERVICE_ROLE_KEY BYPASSES ROW LEVEL SECURITY COMPLETELY. It is a
# superuser credential for your storage and database. It is read only by
# server-only code and must never appear in a NEXT_PUBLIC_* variable — anything
# with that prefix is compiled into the browser bundle.
#
# The browser never talks to Supabase Storage directly: the server mints a
# short-lived signed upload URL and the client PUTs to that.
#
# Create the bucket first (Storage → New bucket). Keep it PRIVATE; the provider
# signs reads for documents and evidence either way.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=""
# The PUBLIC bucket, for avatars and portfolio images only. A single bucket has
# no correct setting: private breaks every avatar (and confirmUpload persists
# the dead URL), public exposes every KYC document to anyone holding the key.
SUPABASE_STORAGE_BUCKET_PUBLIC=""

# Opt-in for tests/storage.test.ts, which WRITES to the bucket. Set it to the same
# value as SUPABASE_STORAGE_BUCKET to run those tests; leave unset and they skip.
# It exists so `pnpm test` against a production .env cannot drop a selftest
# object next to real KYC documents.
STORAGE_TEST_BUCKET=""

# ── Firebase Storage (when STORAGE_PROVIDER=firebase) ───────────────────────
# Not implemented — FirebaseStorageProvider throws on every method. Also
# requires the Blaze plan, which Spark projects are prompted to upgrade to.
FIREBASE_STORAGE_BUCKET=""

# HMAC key for signed upload/read URLs. REQUIRED in production.
# Left unset, each process invents its own random key at startup — which works
# on one dev server and breaks on any multi-instance deployment: a link minted
# by one instance is rejected by the next, and every outstanding link dies on
# each deploy. Generate with: openssl rand -base64 32
STORAGE_SIGNING_SECRET=""


# ═════════════════════════════════════════════════════════════════════════════
# SEEDING
# ═════════════════════════════════════════════════════════════════════════════
# `pnpm db:seed` DELETES EVERY ROW IN EVERY TABLE, and it now refuses to run
# WITHOUT this flag — there is no longer any URL it considers safe by default.
#
# That changed with Postgres. The old guard let any `file:` URL through, on the
# reasoning that a local SQLite file is self-evidently disposable. Nothing is
# self-evidently disposable now: your development database, staging and
# production are the same shape of URL, distinguishable only by host and schema,
# and the seed cannot tell which one you have loaded.
#
# So setting this is an explicit statement that you mean to wipe whatever
# DATABASE_URL currently points at. Check that first.
# SEED_ALLOW_DESTRUCTIVE="1"
