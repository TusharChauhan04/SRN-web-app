# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — every .env is ignored EXCEPT the documented example
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# placeholder database — local SQLite file and its journals are never committed
prisma/*.db
prisma/*.db-journal
prisma/dev.db*

# local file uploads (StorageProvider "local" development mode)
# NOT under public/ — see LOCAL_ROOT in src/lib/providers/storage/index.server.ts
/.data
# retained so an existing checkout's old upload directory is never committed
/public/uploads

# review agent scratch output
.claude/review-logs/
.claude/agent-memory/

# vitest scratch database
prisma/test.db*
